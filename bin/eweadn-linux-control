#!/usr/bin/env python3
"""Read and configure an EWEADN S9-series mouse over its 2.4 GHz receiver.

The receiver exposes a 64-byte vendor feature report (report ID 3, usage page
0xFF00).  The queries and write commands below were recovered from EWEADN's
official web driver and the @bytech/mouse-pix SDK.

Battery output is backwards compatible with the original helper:

    eweadn-linux-control --json

New commands:

    eweadn-linux-control config --json
    eweadn-linux-control set-polling 8000 --apply
    eweadn-linux-control set-dpi 1 1600 --apply
    eweadn-linux-control set-button back dpi_loop --apply
    eweadn-linux-control backup
    eweadn-linux-control restore --backup FILE --apply

Writes are dry-run unless --apply is passed.  Every applied write saves the
current configuration first and reads it back afterwards.
"""

from __future__ import annotations

import argparse
import errno
import fcntl
import glob
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime

VID = 0x372E
KNOWN_PIDS = {
    0x1026,  # S9 Pro / S9 8K receiver
    0x1027,  # S9 Ultra on its USB cable
    0x1033,  # 1K receiver
    0x103D,  # S9 Pro 1K receiver
    0x1055,  # S9 Max / Ultra receiver
    0x105E,  # S9 Max / Ultra receiver
}
CABLE_PIDS = {0x1027}
PRODUCT_NAMES = {
    0x1026: "EWEADN S9 8K receiver",
    0x1027: "EWEADN S9 USB cable",
    0x1033: "EWEADN S9 1K receiver",
    0x103D: "EWEADN S9 Pro 1K receiver",
    0x1055: "EWEADN S9 Max receiver",
    0x105E: "EWEADN S9 Ultra receiver",
}

SYSFS_HIDRAW = "/sys/class/hidraw"
REPORT_ID = 0x03
FRAME_SIZE = 64
DPI_TABLE_SIZE = 64
KEY_TABLE_SIZE = 48
BACKUP_SIZE_LIMIT = 1 << 20

POLLING_RATES = {
    0: 1000,
    1: 500,
    2: 250,
    3: 125,
    4: 8000,
    5: 4000,
    6: 2000,
}
HZ_TO_CODE = {hz: code for code, hz in POLLING_RATES.items()}

# Exact values from @bytech/mouse-pix 1.11.1.
KEY_POS = {
    "left": 0,
    "right": 4,
    "middle": 8,
    "back": 12,
    "forward": 16,
}
KEY_TYPE = {
    "keyboard": 0,
    "mouse": 1,
    "multimedia": 2,
    "macro": 3,
    "custom": 4,
    "dpi": 5,
    "profile": 6,
    "report": 9,
}
MOUSE_CODE = {
    "left": 1,
    "right": 2,
    "middle": 3,
    "forward": 4,
    "back": 5,
}
MOUSE_CODE_NAME = {value: name for name, value in MOUSE_CODE.items()}
BUTTON_NAMES = ["left", "right", "middle", "back", "forward"]

# (keyType, keyCode, times, gap)
BUTTON_ACTIONS = {
    "left": (KEY_TYPE["mouse"], MOUSE_CODE["left"], 1, 0),
    "right": (KEY_TYPE["mouse"], MOUSE_CODE["right"], 1, 0),
    "middle": (KEY_TYPE["mouse"], MOUSE_CODE["middle"], 1, 0),
    "forward": (KEY_TYPE["mouse"], MOUSE_CODE["forward"], 1, 0),
    "back": (KEY_TYPE["mouse"], MOUSE_CODE["back"], 1, 0),
    "dpi_up": (KEY_TYPE["dpi"], 1, 1, 0),
    "dpi_down": (KEY_TYPE["dpi"], 2, 1, 0),
    "dpi_loop": (KEY_TYPE["dpi"], 4, 1, 0),
    "profile_1": (KEY_TYPE["profile"], 1, 0, 0),
    "profile_2": (KEY_TYPE["profile"], 2, 0, 0),
    "profile_3": (KEY_TYPE["profile"], 3, 0, 0),
    "profile_4": (KEY_TYPE["profile"], 4, 0, 0),
    "profile_cycle": (KEY_TYPE["profile"], 5, 0, 0),
    "media_play_pause": (KEY_TYPE["multimedia"], 0, 0, 0xCD),
    "media_next": (KEY_TYPE["multimedia"], 0, 0, 0xB5),
    "media_prev": (KEY_TYPE["multimedia"], 0, 0, 0xB6),
    "media_mute": (KEY_TYPE["multimedia"], 0, 0, 0xE2),
    "volume_up": (KEY_TYPE["multimedia"], 0, 0, 0xE9),
    "volume_down": (KEY_TYPE["multimedia"], 0, 0, 0xEA),
    "disabled": (0, 0, 0, 0),
}
ACTION_NAMES = list(BUTTON_ACTIONS)

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
COLOR_RE = re.compile(r"#[0-9A-Fa-f]{6}")
MAC_RE = re.compile(r"[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}")
BT_NAME_TERMS = ("eweadn",)
BATTERY_PERCENT_RE = re.compile(
    r"Battery Percentage:\s+(?:0x[0-9A-Fa-f]+\s+)?"
    r"(?:\((\d{1,3})\)|(\d{1,3})\s*%?)"
)
LOCK_TIMEOUT = 1.5
LOCK_RETRY = 0.05


class DeviceError(Exception):
    exit_code = 1

    def __init__(self, message: str, *, backup: str | None = None) -> None:
        if backup and backup not in message:
            message = f"{message} (backup: {backup})"
        super().__init__(message)
        self.backup = backup


class DeviceNotFound(DeviceError):
    exit_code = 2


class PermissionDenied(DeviceError):
    exit_code = 3


class NoReply(DeviceError):
    exit_code = 4


class ProtocolError(DeviceError):
    exit_code = 5


class LockError(DeviceError):
    pass


class BackupError(DeviceError):
    pass


class RestoreError(DeviceError):
    pass


def _ioc(direction: int, nr: int, size: int) -> int:
    return (direction << 30) | (size << 16) | (ord("H") << 8) | nr


HIDIOCSFEATURE = _ioc(3, 0x06, FRAME_SIZE)  # _IOWR('H', 0x06, 64)
HIDIOCGFEATURE = _ioc(3, 0x07, FRAME_SIZE)  # _IOWR('H', 0x07, 64)


def map_os_error(exc: OSError, context: str) -> DeviceError:
    """Translate expected kernel errors into the CLI failure contract."""
    if exc.errno in (errno.EACCES, errno.EPERM):
        return PermissionDenied(f"{context}: permission denied (install the udev rule)")
    if exc.errno in (errno.ENODEV, errno.ENOENT):
        return DeviceNotFound(f"{context}: {exc.strerror or exc}")
    if exc.errno in (errno.EIO, errno.ESHUTDOWN, errno.ETIMEDOUT):
        return NoReply(f"{context}: {exc.strerror or exc}")
    return DeviceError(f"{context}: {exc.strerror or exc}")


def with_backup(exc: DeviceError, backup: str | None) -> DeviceError:
    """Attach the pre-write backup path to an error exactly once."""
    if backup and not exc.backup:
        exc.backup = backup
        message = str(exc)
        if backup not in message:
            exc.args = (f"{message} (backup: {backup})",)
    return exc


def sanitize_name(name: object) -> str:
    """Make device-derived text safe for one-line human-readable output."""
    text = ANSI_RE.sub("", str(name or ""))
    text = text.replace("\r", " ").replace("\n", " ").replace("\t", " ")
    text = CONTROL_RE.sub("", text)
    return " ".join(text.split())[:120]


def friendly_name(raw: str, product: int) -> str:
    clean = sanitize_name(raw)
    if clean and "eweadn" in clean.lower():
        return clean
    return PRODUCT_NAMES.get(product, f"EWEADN device {product:04x}")


def _read_report_descriptor(hidraw_dir: str) -> bytes | None:
    path = os.path.join(hidraw_dir, "device", "report_descriptor")
    try:
        with open(path, "rb") as handle:
            return handle.read(65536)
    except OSError:
        return None


def descriptor_matches(
    descriptor: bytes, usage_page: int = 0xFF00, report_id: int = REPORT_ID
) -> bool:
    """Return True for a vendor-page feature report with the expected ID."""
    index = 0
    current_page = 0
    current_report = 0
    stack: list[tuple[int, int]] = []
    sizes = {0: 0, 1: 1, 2: 2, 3: 4}
    while index < len(descriptor):
        prefix = descriptor[index]
        index += 1
        if prefix == 0xFE:  # long item
            if index + 2 > len(descriptor):
                return False
            size = descriptor[index]
            index += 2
            if index + size > len(descriptor):
                return False
            index += size
            continue
        size = sizes[prefix & 0x03]
        if index + size > len(descriptor):
            return False
        value = (
            int.from_bytes(descriptor[index : index + size], "little")
            if size
            else 0
        )
        index += size
        item_type = (prefix >> 2) & 0x03
        tag = (prefix >> 4) & 0x0F
        if item_type == 0:  # main item
            if tag == 0x0B and current_page == usage_page and current_report == report_id:
                return True
        elif item_type == 1:  # global item
            if tag == 0x00:
                current_page = value
            elif tag == 0x08:
                current_report = value
            elif tag == 0x0A:
                stack.append((current_page, current_report))
            elif tag == 0x0B and stack:
                current_page, current_report = stack.pop()
    return False


def candidates(root: str | None = None) -> list[tuple[str, str, int, int]]:
    """Return (device path, name, vendor, product) for vendor HID nodes."""
    root = root or SYSFS_HIDRAW
    found: list[tuple[str, str, int, int]] = []
    pattern = os.path.join(root, "hidraw*", "device", "uevent")
    for uevent in glob.glob(pattern):
        try:
            with open(uevent, encoding="utf-8", errors="replace") as handle:
                text = handle.read()
        except OSError:
            continue

        name = ""
        hid_id = ""
        for line in text.splitlines():
            if line.startswith("HID_NAME="):
                name = line.partition("=")[2]
            elif line.startswith("HID_ID="):
                hid_id = line.partition("=")[2]

        parts = hid_id.split(":")
        if len(parts) != 3:
            continue
        try:
            vendor = int(parts[1], 16)
            product = int(parts[2], 16)
        except ValueError:
            continue

        if vendor != VID or product not in KNOWN_PIDS:
            continue

        hidraw_dir = os.path.dirname(os.path.dirname(uevent))
        descriptor = _read_report_descriptor(hidraw_dir)
        if descriptor is None or not descriptor_matches(descriptor):
            # Never guess from VID/PID alone: input/keyboard nodes do not
            # carry the vendor feature report used by this helper.
            continue

        hidraw = os.path.basename(hidraw_dir)
        found.append(
            ("/dev/" + hidraw, friendly_name(name, product), vendor, product)
        )

    found.sort()
    return found


def build_request(cmd: int, sub: int, data: bytes = b"", encap: int = 0) -> bytes:
    """Build the 64-byte feature report including report ID and checksum."""
    if len(data) > 57:
        raise ValueError("payload too large")
    request = bytearray(FRAME_SIZE)
    request[0] = REPORT_ID
    request[2] = 0x50
    request[3] = len(data)
    request[4] = encap & 0xFF
    request[5] = cmd & 0xFF
    request[6] = sub & 0xFF
    request[7 : 7 + len(data)] = data
    request[1] = sum(request[1:]) & 0xFF
    return bytes(request)


def state_home() -> str:
    configured = os.environ.get("XDG_STATE_HOME")
    if configured and os.path.isabs(configured):
        return configured
    return os.path.join(os.path.expanduser("~"), ".local", "state")


def ensure_private_directory(
    path: str, label: str, error: type[DeviceError] = DeviceError
) -> None:
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            raise error(f"{label} {path} is not a real directory")
        if info.st_uid != os.getuid():
            raise error(f"{label} {path} is not owned by uid {os.getuid()}")
        if stat.S_IMODE(info.st_mode) != 0o700:
            os.chmod(path, 0o700)
    except DeviceError:
        raise
    except OSError as exc:
        raise error(f"could not prepare {label} {path}: {exc}") from exc


def _verified_runtime_dir() -> str | None:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not os.path.isabs(runtime):
        return None
    try:
        info = os.lstat(runtime)
    except OSError:
        return None
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        return None
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        return None
    return runtime


def lock_path() -> str:
    runtime = _verified_runtime_dir()
    if runtime:
        return os.path.join(runtime, "eweadn-linux-control.lock")
    return os.path.join(state_home(), "eweadn-linux-control", "lock")


def release_lock(fd: int | None) -> None:
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def acquire_lock() -> int:
    """Take a private, bounded, non-blocking lock on the vendor HID device."""
    path = lock_path()
    runtime = _verified_runtime_dir()
    if runtime is None:
        ensure_private_directory(
            os.path.dirname(path), "lock directory", LockError
        )

    flags = os.O_CREAT | os.O_RDWR
    flags |= getattr(os, "O_NOFOLLOW", 0)
    flags |= getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(path, flags, 0o600)
    except OSError as exc:
        raise LockError(f"could not open lock {path}: {exc}") from exc

    deadline = time.monotonic() + LOCK_TIMEOUT
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError as exc:
                if time.monotonic() >= deadline:
                    raise LockError(
                        "another eweadn-linux-control process is busy "
                        f"(lock {path})"
                    ) from exc
                time.sleep(LOCK_RETRY)
            except OSError as exc:
                raise LockError(f"could not lock {path}: {exc}") from exc

        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise LockError(f"lock {path} is not a regular file")
        if info.st_uid != os.getuid():
            raise LockError(f"lock {path} is not owned by uid {os.getuid()}")
        os.fchmod(fd, 0o600)
        path_info = os.lstat(path)
        if (path_info.st_dev, path_info.st_ino) != (info.st_dev, info.st_ino):
            raise LockError(f"lock {path} was replaced while acquiring it")
        return fd
    except LockError:
        release_lock(fd)
        raise
    except OSError as exc:
        release_lock(fd)
        raise LockError(f"could not prepare lock {path}: {exc}") from exc
    except BaseException:
        release_lock(fd)
        raise


class HidSession:
    """One open hidraw node with serialized request/response exchanges."""

    def __init__(
        self, path: str, name: str, vendor: int, product: int, lock_fd: int | None
    ):
        self.path = path
        self.name = name
        self.vendor = vendor
        self.product = product
        self.lock_fd: int | None = lock_fd
        self.fd: int | None = None
        try:
            self.fd = os.open(path, os.O_RDWR | getattr(os, "O_CLOEXEC", 0))
        except OSError as exc:
            raise map_os_error(exc, f"could not open {path}") from exc

    def close(self) -> None:
        if self.fd is not None:
            fd = self.fd
            self.fd = None
            try:
                os.close(fd)
            except OSError:
                pass
        if self.lock_fd is not None:
            fd = self.lock_fd
            self.lock_fd = None
            release_lock(fd)

    def __enter__(self) -> "HidSession":
        return self

    def __exit__(self, *_exc: object) -> None:
        self.close()

    def _exchange(
        self, cmd: int, sub: int, data: bytes, timeout: float, encap: int = 0
    ) -> tuple[bytes, bytes]:
        if self.fd is None:
            raise DeviceNotFound("HID device is closed")
        fd = self.fd
        request = bytearray(build_request(cmd, sub, data, encap))

        try:
            fcntl.ioctl(fd, HIDIOCSFEATURE, request)
        except OSError as exc:
            raise map_os_error(exc, "could not send the feature report") from exc

        # The receiver needs a moment to stage the answer.
        time.sleep(0.06)
        deadline = time.monotonic() + timeout
        last_status = None
        while time.monotonic() < deadline:
            reply = bytearray(FRAME_SIZE)
            reply[0] = REPORT_ID
            try:
                fcntl.ioctl(fd, HIDIOCGFEATURE, reply)
            except OSError as exc:
                if exc.errno in (
                    errno.EACCES,
                    errno.EPERM,
                    errno.ENODEV,
                    errno.ENOENT,
                    errno.EIO,
                    errno.ESHUTDOWN,
                ):
                    raise map_os_error(
                        exc, "could not read the feature report"
                    ) from exc
                time.sleep(0.008)
                continue

            if reply[0] != REPORT_ID or reply[1] != 0x50:
                time.sleep(0.008)
                continue

            status = reply[2]
            length = reply[3]
            if status == 0:
                if length > 58:
                    raise ProtocolError(f"reply length {length} is too large")
                return bytes(reply[6 : 6 + length]), bytes(reply)
            last_status = status
            time.sleep(0.008)

        if last_status == 2:
            raise NoReply("mouse asleep or offline")
        if last_status is not None:
            raise ProtocolError(f"device returned status {last_status}")
        raise NoReply("no reply (mouse asleep or out of range)")

    def query(
        self,
        cmd: int,
        sub: int = 0,
        data: bytes = b"",
        *,
        attempts: int = 4,
        timeout: float = 0.35,
        encap: int = 0,
    ) -> tuple[bytes, bytes]:
        last: DeviceError | None = None
        for attempt in range(attempts):
            if attempt:
                time.sleep(0.12)
            try:
                return self._exchange(cmd, sub, data, timeout, encap)
            except (NoReply, ProtocolError) as exc:
                last = exc
        if last is not None:
            raise last
        raise NoReply("no reply (mouse asleep or out of range)")


def find_session() -> HidSession:
    nodes = candidates()
    if not nodes:
        raise DeviceNotFound("EWEADN receiver not found")

    lock_fd = acquire_lock()
    try:
        # The receiver may have been unplugged or re-enumerated while we
        # waited for the lock, so discover the nodes again.
        nodes = candidates()
        if not nodes:
            raise DeviceNotFound("EWEADN receiver not found")

        permission_error: PermissionDenied | None = None
        last_error: DeviceError | None = None
        for path, name, vendor, product in nodes:
            try:
                return HidSession(path, name, vendor, product, lock_fd)
            except PermissionDenied as exc:
                permission_error = exc
                last_error = exc
            except DeviceError as exc:
                last_error = exc

        if permission_error is not None:
            raise permission_error
        if last_error is not None:
            raise last_error
        raise DeviceNotFound("EWEADN receiver not found")
    except BaseException:
        release_lock(lock_fd)
        raise


def source_for_product(product: int) -> str:
    return "USB cable" if product in CABLE_PIDS else "2.4 GHz receiver"


def read_chunks(
    session: HidSession,
    cmd: int,
    sub: int,
    total: int,
    *,
    packet_limit: int = 10,
) -> bytes:
    """Read a multi-packet feature response and require the full payload."""
    if total <= 0:
        return b""
    chunks = max(1, (total + packet_limit - 1) // packet_limit)
    data = bytearray()
    for index in range(chunks):
        try:
            chunk, _ = session.query(cmd, sub + index, encap=index)
        except DeviceError as exc:
            if not data:
                # Nothing was returned yet, so preserve the transport error
                # (permission, sleep, etc.) instead of reporting corruption.
                raise
            raise ProtocolError(
                f"multipacket read failed at chunk {index + 1}/{chunks}: "
                f"expected {total} bytes, received {len(data)} bytes "
                f"({exc})"
            ) from exc
        if not chunk:
            raise ProtocolError(
                f"multipacket read failed at chunk {index + 1}/{chunks}: "
                f"empty reply; expected {total} bytes, received {len(data)} "
                "bytes"
            )
        # Follow-up responses carry a one-byte sequence/offset prefix before
        # the next slice of the logical payload.
        if index > 0:
            chunk = chunk[1:]
            if not chunk:
                raise ProtocolError(
                    f"multipacket read failed at chunk {index + 1}/{chunks}: "
                    f"sequence-only reply; expected {total} bytes, received "
                    f"{len(data)} bytes"
                )
        data.extend(chunk)
        if len(data) >= total:
            break

    if len(data) < total:
        raise ProtocolError(
            f"short multipacket reply: expected {total} bytes, received "
            f"{len(data)} bytes"
        )
    return bytes(data[:total])


def decode_dpi(raw: int, max_dpi: int) -> int:
    """Decode the sensor's 16-bit DPI field."""
    limit = max(0, max_dpi // 50 - 1)
    if raw <= limit:
        return (raw + 1) * 50
    return raw


def encode_dpi(dpi: int, max_dpi: int) -> int:
    """Encode DPI the same way the vendor SDK does."""
    if dpi <= max_dpi:
        return max(0, dpi // 50 - 1)
    return dpi


def parse_basics(data: bytes) -> dict:
    if len(data) < 7:
        raise ProtocolError(f"basic info reply is only {len(data)} bytes")
    status = data[0]
    charging = bool(status & 0x80)
    level = status & 0x7F
    if charging:
        percent = None
    elif level <= 100:
        percent = level
    else:
        raise ProtocolError(f"invalid battery level 0x{level:02X}")

    profile_byte = data[1]
    return {
        "battery": {
            "percent": percent,
            "charging": charging,
            "raw": status,
        },
        "profile": {
            "current": profile_byte & 0x0F,
            "max": (profile_byte >> 4) & 0x0F,
        },
        "max_report_code": data[2],
        "sensor_code": data[3],
        "max_dpi": data[4] | (data[5] << 8),
        "macro_size": data[6],
    }


def parse_sensor(data: bytes) -> dict:
    if len(data) < 6:
        raise ProtocolError(f"sensor reply is only {len(data)} bytes")
    flags = data[1]
    dpi_byte = data[2]
    return {
        "sensor_code": data[0],
        "is_single_adjust": bool(flags & 0x80),
        "wired_rate_code": (flags >> 4) & 0x07,
        "wireless_rate_code": flags & 0x07,
        "current_stage": ((dpi_byte >> 4) & 0x0F) or 1,
        "stage_count": (dpi_byte & 0x0F) or 6,
        "lod": data[3],
        "debounce": data[4],
        "flags": data[5],
        "sleep_broadcast": data[6] if len(data) > 6 else None,
        "sleep_reconnect": data[7] if len(data) > 7 else None,
        "sleep": data[8] if len(data) > 8 else None,
        "current_profile": data[9] if len(data) > 9 else None,
    }


def parse_dpi(data: bytes, max_dpi: int) -> list[dict]:
    stages: list[dict] = []
    for index in range(8):
        value_offset = 1 + index * 2
        color_offset = 17 + index * 3
        if value_offset + 1 >= len(data) or color_offset + 2 >= len(data):
            break
        raw = data[value_offset] | (data[value_offset + 1] << 8)
        color = data[color_offset : color_offset + 3]
        stages.append(
            {
                "index": index + 1,
                "raw": raw,
                "dpi": decode_dpi(raw, max_dpi),
                "color": "#{:02x}{:02x}{:02x}".format(*color),
            }
        )
    return stages


def parse_keys(data: bytes) -> list[dict]:
    keys: list[dict] = []
    for index in range(5):
        offset = index * 4
        if offset + 3 >= len(data):
            break
        key_type = data[offset]
        code1 = data[offset + 1]
        code2 = data[offset + 2]
        code3 = data[offset + 3]
        action = "raw"
        if key_type == KEY_TYPE["mouse"]:
            action = MOUSE_CODE_NAME.get(code1, f"mouse_{code1}")
        elif key_type == KEY_TYPE["dpi"]:
            action = {1: "dpi_up", 2: "dpi_down", 4: "dpi_loop"}.get(
                code1, f"dpi_{code1}"
            )
        elif key_type == KEY_TYPE["profile"]:
            action = (
                f"profile_{code1}" if 1 <= code1 <= 4 else "profile_cycle"
            )
        elif key_type == KEY_TYPE["multimedia"]:
            action = {
                0xCD: "media_play_pause",
                0xB5: "media_next",
                0xB6: "media_prev",
                0xE2: "media_mute",
                0xE9: "volume_up",
                0xEA: "volume_down",
            }.get(code3, f"media_{code3:02x}")
        elif key_type == KEY_TYPE["macro"]:
            action = f"macro_{code3}"
        elif key_type == KEY_TYPE["report"]:
            action = "report_switch"
        elif key_type == 0 and code1 == 0 and code2 == 0 and code3 == 0:
            action = "disabled"
        elif key_type == KEY_TYPE["keyboard"]:
            action = "keyboard"

        keys.append(
            {
                "index": index,
                "button": BUTTON_NAMES[index],
                "key_type": key_type,
                "code1": code1,
                "code2": code2,
                "code3": code3,
                "action": action,
            }
        )
    return keys


def resolve_bluetoothctl() -> str:
    path = shutil.which("bluetoothctl")
    if not path:
        raise DeviceNotFound("bluetoothctl is not installed")
    if not os.path.isabs(path):
        raise DeviceNotFound("refusing to run bluetoothctl from a relative path")
    return path


def bluetoothctl(*args: str) -> str:
    command = resolve_bluetoothctl()
    try:
        result = subprocess.run(
            [command, *args],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
    except FileNotFoundError as exc:
        raise DeviceNotFound("bluetoothctl is not installed") from exc
    except subprocess.TimeoutExpired as exc:
        raise NoReply("Bluetooth query timed out") from exc
    except OSError as exc:
        raise map_os_error(exc, "could not run bluetoothctl") from exc

    text = ANSI_RE.sub("", result.stdout + "\n" + result.stderr)
    if result.returncode != 0:
        detail = sanitize_name(text) or f"exit status {result.returncode}"
        raise NoReply(
            f"bluetoothctl {' '.join(args)} failed: {detail}"
        )
    return text


def parse_bluetooth_devices(text: str) -> list[tuple[str, str]]:
    devices: list[tuple[str, str]] = []
    for line in text.splitlines():
        match = re.match(
            r"Device\s+([0-9A-Fa-f:]{17})\s+(.+)", ANSI_RE.sub("", line).strip()
        )
        if not match or not MAC_RE.fullmatch(match.group(1)):
            continue
        name = sanitize_name(match.group(2))
        if name:
            devices.append((match.group(1), name))
    return devices


def bluetooth_name_matches(name: str) -> bool:
    clean = sanitize_name(name).lower()
    for term in BT_NAME_TERMS:
        pattern = rf"(?<![a-z0-9]){re.escape(term)}(?![a-z0-9])"
        if re.search(pattern, clean):
            return True
    return False


def parse_bluetooth_info(text: str) -> dict:
    text = ANSI_RE.sub("", text)
    percent = None
    for match in BATTERY_PERCENT_RE.finditer(text):
        value = int(match.group(1) or match.group(2))
        if 0 <= value <= 100:
            percent = value
            break

    connected = bool(re.search(r"^\s*Connected:\s+yes\s*$", text, re.MULTILINE))
    name_match = re.search(r"^\s*Name:\s+(.+)$", text, re.MULTILINE)
    name = sanitize_name(name_match.group(1)) if name_match else None
    return {
        "connected": connected,
        "percent": percent,
        "name": name or None,
    }


def read_bluetooth_battery() -> dict:
    devices = parse_bluetooth_devices(bluetoothctl("devices"))
    candidates = [
        (mac, name) for mac, name in devices if bluetooth_name_matches(name)
    ]
    if not candidates:
        raise DeviceNotFound("no paired EWEADN Bluetooth device")

    last_error: DeviceError | None = None
    for mac, advertised_name in candidates:
        try:
            info_text = bluetoothctl("info", mac)
        except DeviceError as exc:
            last_error = exc
            continue
        info = parse_bluetooth_info(info_text)
        if not info["connected"] or info["percent"] is None:
            continue
        name = info["name"] or advertised_name
        return {
            "ok": True,
            "percent": info["percent"],
            "charging": False,
            "charging_known": False,
            "status": None,
            "path": mac,
            "name": name,
            "vendor": "",
            "product": "",
            "source": "Bluetooth",
            "raw": f"battery={info['percent']}",
            "battery": {
                "percent": info["percent"],
                "charging": False,
                "raw": None,
            },
        }

    if last_error is not None:
        raise NoReply(f"could not read EWEADN Bluetooth battery: {last_error}")
    raise DeviceNotFound(
        "EWEADN Bluetooth device is not connected or exposes no battery level"
    )


def bluetooth_config() -> tuple[dict, dict]:
    battery = read_bluetooth_battery()
    config = {
        "ok": True,
        "settings_available": False,
        "device": {
            "path": battery["path"],
            "name": battery["name"],
            "vendor": "",
            "product": "",
            "source": "Bluetooth",
            "wired": False,
            "bluetooth": True,
        },
        "battery": battery["battery"],
        "polling": None,
        "dpi": None,
        "buttons": [],
        "profile": {"current": 0, "max": 0, "sensor_current": None},
        "sensor": {},
    }
    return config, {"bluetooth": battery["raw"]}


def _fallback_allowed(exc: DeviceError) -> bool:
    return isinstance(exc, (DeviceNotFound, NoReply))


def combine_errors(primary: DeviceError, secondary: DeviceError) -> DeviceError:
    combined = type(primary)(f"{primary}; Bluetooth: {secondary}")
    combined.backup = getattr(primary, "backup", None)
    return combined


def read_battery(session: HidSession | None = None) -> tuple[dict, bytes]:
    own = session is None
    usb_error: DeviceError | None = None

    if session is None:
        try:
            session = find_session()
        except DeviceError as exc:
            if not _fallback_allowed(exc):
                raise
            usb_error = exc

    if session is not None:
        try:
            data, raw = session.query(0x4F, 0x81)
            parsed = parse_basics(data)
            battery = parsed["battery"]
            result = {
                "ok": True,
                "percent": battery["percent"],
                "charging": battery["charging"],
                "status": battery["raw"],
                "path": session.path,
                "name": session.name,
                "vendor": f"{session.vendor:04x}",
                "product": f"{session.product:04x}",
                "source": source_for_product(session.product),
                "raw": raw[:16].hex(" "),
                "battery": battery,
            }
            return result, raw
        except DeviceError as exc:
            if not _fallback_allowed(exc):
                raise
            usb_error = exc
        finally:
            if own:
                session.close()

    try:
        return read_bluetooth_battery(), b""
    except DeviceError as bt_error:
        if usb_error is not None:
            raise combine_errors(usb_error, bt_error)
        raise


def read_config(session: HidSession | None = None) -> tuple[dict, dict]:
    own = session is None
    if session is None:
        session = find_session()
    try:
        basics_data, basics_raw = session.query(0x4F, 0x81)
        sensor_data, sensor_raw = session.query(0x4F, 0x40)
        dpi_data = read_chunks(session, 0x4F, 0x41, DPI_TABLE_SIZE)
        keys_data = read_chunks(session, 0x4F, 0x00, KEY_TABLE_SIZE)
        dpi_raw = dpi_data[:16]
        keys_raw = keys_data[:16]

        basics = parse_basics(basics_data)
        sensor = parse_sensor(sensor_data)
        stage_count = sensor["stage_count"]
        if not 1 <= stage_count <= 8:
            raise ProtocolError(
                f"sensor reported invalid DPI stage count {stage_count}"
            )
        max_dpi = basics["max_dpi"] or 30000
        parsed_stages = parse_dpi(dpi_data, max_dpi)
        if len(parsed_stages) < stage_count:
            raise ProtocolError(
                f"DPI table has {len(parsed_stages)} stages, expected "
                f"{stage_count}"
            )
        stages = parsed_stages[:stage_count]
        buttons = parse_keys(keys_data)
        if len(buttons) != 5:
            raise ProtocolError(
                f"button table has {len(buttons)} buttons, expected 5"
            )
        wired = session.product in CABLE_PIDS
        rate_code = (
            sensor["wired_rate_code"] if wired else sensor["wireless_rate_code"]
        )

        config = {
            "ok": True,
            "device": {
                "path": session.path,
                "name": session.name,
                "vendor": f"{session.vendor:04x}",
                "product": f"{session.product:04x}",
                "source": source_for_product(session.product),
                "wired": wired,
            },
            "battery": basics["battery"],
            "polling": {
                "hz": POLLING_RATES.get(rate_code, 1000),
                "code": rate_code,
                "is_single_adjust": sensor["is_single_adjust"],
                "max_report_code": basics["max_report_code"],
            },
            "dpi": {
                "sensor_code": basics["sensor_code"],
                "max_dpi": max_dpi,
                "current_stage": sensor["current_stage"],
                "stage_count": stage_count,
                "stages": stages,
            },
            "buttons": buttons,
            "profile": {
                "current": basics["profile"]["current"],
                "max": basics["profile"]["max"],
                "sensor_current": sensor["current_profile"],
            },
            "sensor": sensor,
        }
        raw = {
            "basics": basics_raw[:16].hex(" "),
            "sensor": sensor_raw[:16].hex(" "),
            "dpi": dpi_raw[:16].hex(" "),
            "keys": keys_raw[:16].hex(" "),
        }
        return config, raw
    finally:
        if own:
            session.close()


def backup_directory() -> str:
    return os.path.join(state_home(), "eweadn-linux-control", "backups")


def _next_backup_target(directory: str) -> str:
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    target = os.path.join(directory, f"eweadn-config-{stamp}.json")
    counter = 1
    while os.path.lexists(target):
        target = os.path.join(
            directory, f"eweadn-config-{stamp}-{counter}.json"
        )
        counter += 1
    return target


def backup_path() -> str:
    directory = backup_directory()
    ensure_private_directory(directory, "backup directory", BackupError)
    return _next_backup_target(directory)


def _collision_target(path: str) -> str:
    stem, suffix = os.path.splitext(path)
    counter = 1
    while True:
        candidate = f"{stem}-{counter}{suffix}"
        if not os.path.lexists(candidate):
            return candidate
        counter += 1


def _check_backup_target(path: str) -> None:
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return
    except OSError as exc:
        raise BackupError(f"could not inspect backup {path}: {exc}") from exc
    if stat.S_ISLNK(info.st_mode):
        raise BackupError(f"refusing to write through symlink backup {path}")
    if not stat.S_ISREG(info.st_mode):
        raise BackupError(f"backup target {path} is not a regular file")


def save_backup(config: dict, path: str | None = None) -> str:
    """Write a 0600 backup atomically; automatic names never overwrite."""
    automatic = path is None
    if automatic:
        target = backup_path()
    else:
        if not path:
            raise BackupError("backup path must not be empty")
        target = os.path.abspath(os.path.expanduser(path))

    directory = os.path.dirname(target)
    temp_path: str | None = None
    fd = -1
    try:
        if automatic:
            ensure_private_directory(directory, "backup directory", BackupError)
        else:
            os.makedirs(directory, mode=0o700, exist_ok=True)
            info = os.lstat(directory)
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                raise BackupError(
                    f"backup directory {directory} is not a real directory"
                )
            _check_backup_target(target)

        payload = json.dumps(config, indent=2, sort_keys=True) + "\n"
        fd, temp_path = tempfile.mkstemp(
            prefix=".eweadn-linux-control-", suffix=".tmp", dir=directory
        )
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())

        if automatic:
            # A hard link publishes the complete file atomically and fails
            # with EEXIST instead of replacing an existing backup.
            for _ in range(100):
                try:
                    os.link(temp_path, target, follow_symlinks=False)
                    break
                except FileExistsError:
                    target = _collision_target(target)
            else:
                raise BackupError("could not choose a unique backup name")
            os.unlink(temp_path)
            temp_path = None
        else:
            os.replace(temp_path, target)
            temp_path = None
    except BackupError:
        raise
    except (OSError, TypeError, ValueError) as exc:
        raise BackupError(f"could not write backup {target}: {exc}") from exc
    finally:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass
        if temp_path is not None:
            try:
                os.unlink(temp_path)
            except OSError:
                pass
    return target


def _format_raw(raw: tuple[object, ...]) -> str:
    if not raw or not all(isinstance(value, int) for value in raw):
        return "missing"
    return " ".join(f"{value:02x}" for value in raw)


def verify_config(
    config: dict,
    expectations: list[dict],
    *,
    backup: str | None = None,
) -> None:
    """Compare the exact fields that a write was supposed to change."""
    for expected in expectations:
        kind = expected["kind"]
        if kind == "polling":
            sensor = config.get("sensor") or {}
            transport = expected["transport"]
            actual = sensor.get(f"{transport}_rate_code")
            code = expected["code"]
            if actual != code:
                actual_hz = POLLING_RATES.get(actual)
                read = (
                    f"{actual_hz} Hz (code {actual})"
                    if actual_hz is not None
                    else f"code {actual}"
                )
                raise ProtocolError(
                    f"write verification failed for {transport} polling: "
                    f"expected {POLLING_RATES[code]} Hz (code {code}), "
                    f"read {read}",
                    backup=backup,
                )
        elif kind == "dpi":
            dpi = config.get("dpi") or {}
            stages = {
                stage.get("index"): stage
                for stage in (dpi.get("stages") or [])
            }
            stage = stages.get(expected["stage"])
            expected_text = (
                f"{expected['dpi']} DPI {expected['color']} with "
                f"{expected['stage_count']} stages"
            )
            if (
                stage is None
                or stage.get("dpi") != expected["dpi"]
                or stage.get("color") != expected["color"]
                or dpi.get("stage_count") != expected["stage_count"]
            ):
                if stage is None:
                    actual_text = "stage missing"
                else:
                    actual_text = (
                        f"{stage.get('dpi')} DPI {stage.get('color')} with "
                        f"{dpi.get('stage_count')} stages"
                    )
                raise ProtocolError(
                    f"write verification failed for DPI stage "
                    f"{expected['stage']}: expected {expected_text}, "
                    f"read {actual_text}",
                    backup=backup,
                )
        elif kind == "dpi_current":
            actual = (config.get("dpi") or {}).get("current_stage")
            if actual != expected["stage"]:
                raise ProtocolError(
                    f"write verification failed for the active DPI stage: "
                    f"expected {expected['stage']}, read {actual}",
                    backup=backup,
                )
        elif kind == "button":
            index = expected["index"]
            buttons = config.get("buttons") or []
            if index < len(buttons):
                button = buttons[index]
                actual = tuple(
                    button.get(key)
                    for key in ("key_type", "code1", "code2", "code3")
                )
            else:
                actual = ()
            wanted = tuple(expected["raw"])
            if actual != wanted:
                raise ProtocolError(
                    f"write verification failed for button "
                    f"{BUTTON_NAMES[index]}: expected raw "
                    f"{_format_raw(wanted)}, read {_format_raw(actual)}",
                    backup=backup,
                )
        else:
            raise ValueError(f"unknown verification kind {kind}")


def apply_write(session: HidSession, cmd: int, sub: int, data: bytes) -> None:
    try:
        session.query(cmd, sub, data, attempts=2, timeout=0.25)
    except NoReply:
        # The receiver sometimes applies a write without returning an ack.
        # Verification below is the source of truth.
        pass


def write_and_verify(
    session: HidSession,
    cmd: int,
    sub: int,
    data: bytes,
    expectations: list[dict],
    *,
    backup: str | None = None,
) -> dict:
    try:
        apply_write(session, cmd, sub, data)
        after, _ = read_config(session)
    except DeviceError as exc:
        raise with_backup(exc, backup)
    verify_config(after, expectations, backup=backup)
    return after


def plan_polling(config: dict, hz: int, wired: bool | None) -> tuple[bytes, dict]:
    if hz not in HZ_TO_CODE:
        raise ValueError(
            f"unsupported polling rate {hz}; choose one of "
            f"{sorted(HZ_TO_CODE)}"
        )
    use_wired = config["device"]["wired"] if wired is None else wired
    code = HZ_TO_CODE[hz]
    value = (code << 4) if use_wired else code
    if config["polling"]["is_single_adjust"]:
        value |= 0x80
    return bytes([value]), {
        "transport": "wired" if use_wired else "wireless",
        "hz": hz,
        "code": code,
        "value": value,
    }


def plan_dpi(
    config: dict,
    stage: int,
    dpi: int,
    stage_count: int | None,
    color: str | None,
) -> tuple[bytes, dict]:
    if stage_count is None:
        stage_count = config["dpi"]["stage_count"]
    max_dpi = config["dpi"]["max_dpi"]
    if not 1 <= stage <= 8:
        raise ValueError("DPI stage must be between 1 and 8")
    if not 1 <= stage_count <= 8:
        raise ValueError("stage count must be between 1 and 8")
    if stage > stage_count:
        raise ValueError("active DPI stage is above the stage count")
    if dpi < 50 or dpi > max_dpi:
        raise ValueError(f"DPI must be between 50 and {max_dpi}")
    if dpi % 50:
        raise ValueError("DPI must be a multiple of 50")

    stages = {s["index"]: s for s in config["dpi"]["stages"]}
    if color is not None:
        if not COLOR_RE.fullmatch(color):
            raise ValueError("color must be #RRGGBB")
        stage_color = color.lower()
    else:
        if stage not in stages:
            raise ValueError(f"DPI stage {stage} was not returned by the mouse")
        stage_color = stages[stage]["color"].lower()

    raw = encode_dpi(dpi, max_dpi)
    combined = ((stage & 0x0F) << 4) | (stage_count & 0x0F)
    payload = bytes([combined, raw & 0xFF, (raw >> 8) & 0xFF, *bytes.fromhex(stage_color[1:])])
    return payload, {
        "stage": stage,
        "stage_count": stage_count,
        "dpi": dpi,
        "color": stage_color,
        "raw": raw,
    }


def plan_button(index: int, action: str) -> tuple[int, bytes, dict]:
    if not 0 <= index <= 4:
        raise ValueError("button index must be 0-4")
    if action not in BUTTON_ACTIONS:
        raise ValueError(
            f"unknown action {action}; choose one of {', '.join(ACTION_NAMES)}"
        )
    key_type, code, times, gap = BUTTON_ACTIONS[action]
    pos = KEY_POS[BUTTON_NAMES[index]]
    payload = bytes([key_type, code, times, gap])
    return pos, payload, {
        "index": index,
        "button": BUTTON_NAMES[index],
        "action": action,
        "key_type": key_type,
        "code": code,
        "times": times,
        "gap": gap,
    }


def _backup_int(
    mapping: dict, key: str, label: str, minimum: int, maximum: int
) -> int:
    value = mapping.get(key)
    if isinstance(value, bool) or not isinstance(value, int):
        raise RestoreError(f"{label} must be an integer")
    if not minimum <= value <= maximum:
        raise RestoreError(
            f"{label} must be between {minimum} and {maximum}"
        )
    return value


def normalize_backup(document: dict) -> dict:
    if not isinstance(document, dict):
        raise RestoreError("backup must contain a JSON object")

    device = document.get("device") or {}
    if not isinstance(device, dict):
        raise RestoreError("backup device information is invalid")
    wired = device.get("wired", False)
    if not isinstance(wired, bool):
        raise RestoreError("backup device.wired must be true or false")

    polling = document.get("polling")
    if not isinstance(polling, dict):
        raise RestoreError("backup is missing polling settings")
    hz = polling.get("hz")
    code = polling.get("code")
    if hz is None and isinstance(code, int) and not isinstance(code, bool):
        hz = POLLING_RATES.get(code)
    if isinstance(hz, bool) or not isinstance(hz, int) or hz not in HZ_TO_CODE:
        raise RestoreError(f"backup polling rate is not supported: {hz!r}")
    expected_code = HZ_TO_CODE[hz]
    if code is not None and (
        isinstance(code, bool) or not isinstance(code, int)
        or code != expected_code
    ):
        raise RestoreError("backup polling code does not match its rate")
    single_adjust = polling.get("is_single_adjust", False)
    if not isinstance(single_adjust, bool):
        raise RestoreError(
            "backup polling.is_single_adjust must be true or false"
        )

    dpi = document.get("dpi")
    if not isinstance(dpi, dict):
        raise RestoreError("backup is missing DPI settings")
    stage_count = _backup_int(dpi, "stage_count", "backup DPI stage count", 1, 8)
    max_dpi = dpi.get("max_dpi", 30000)
    if isinstance(max_dpi, bool) or not isinstance(max_dpi, int) or max_dpi < 50:
        raise RestoreError("backup DPI maximum is invalid")
    current_stage = _backup_int(
        dpi, "current_stage", "backup current DPI stage", 1, stage_count
    )
    stages_raw = dpi.get("stages")
    if not isinstance(stages_raw, list):
        raise RestoreError("backup is missing the DPI stage table")

    stages: dict[int, dict] = {}
    for entry in stages_raw:
        if not isinstance(entry, dict):
            raise RestoreError("backup DPI stage entry is invalid")
        index = _backup_int(entry, "index", "backup DPI stage index", 1, 8)
        if index in stages:
            raise RestoreError(f"backup repeats DPI stage {index}")
        value = _backup_int(
            entry, "dpi", f"backup DPI stage {index} value", 50, max_dpi
        )
        if value % 50:
            raise RestoreError(
                f"backup DPI stage {index} is not a multiple of 50"
            )
        color = entry.get("color")
        if not isinstance(color, str) or not COLOR_RE.fullmatch(color):
            raise RestoreError(f"backup DPI stage {index} color is invalid")
        stages[index] = {
            "index": index,
            "dpi": value,
            "color": color.lower(),
            "raw": encode_dpi(value, max_dpi),
        }

    missing = [index for index in range(1, stage_count + 1) if index not in stages]
    if missing:
        raise RestoreError(
            "backup is missing DPI stage(s) "
            + ", ".join(str(index) for index in missing)
        )

    buttons_raw = document.get("buttons")
    if not isinstance(buttons_raw, list) or len(buttons_raw) != 5:
        raise RestoreError("backup must contain exactly five buttons")
    buttons: dict[int, tuple[int, int, int, int]] = {}
    for position, entry in enumerate(buttons_raw):
        if not isinstance(entry, dict):
            raise RestoreError("backup button entry is invalid")
        if "index" in entry:
            index = _backup_int(
                entry, "index", "backup button index", 0, 4
            )
        else:
            index = position
        if index in buttons:
            raise RestoreError(f"backup repeats button {index}")
        raw = tuple(
            _backup_int(entry, key, f"backup button {index} {key}", 0, 255)
            for key in ("key_type", "code1", "code2", "code3")
        )
        buttons[index] = raw  # type: ignore[assignment]
    if set(buttons) != {0, 1, 2, 3, 4}:
        raise RestoreError("backup must contain buttons 0 through 4")

    return {
        "polling": {
            "hz": hz,
            "code": expected_code,
            "transport": "wired" if wired else "wireless",
            "single_adjust": single_adjust,
        },
        "dpi": {
            "stage_count": stage_count,
            "current_stage": current_stage,
            "max_dpi": max_dpi,
            "stages": [stages[index] for index in range(1, stage_count + 1)],
        },
        "buttons": [
            {"index": index, "raw": buttons[index]}
            for index in range(5)
        ],
    }


def plan_restore(document: dict) -> tuple[list[dict], dict]:
    normalized = normalize_backup(document)
    polling = normalized["polling"]
    dpi = normalized["dpi"]
    buttons = normalized["buttons"]

    code = polling["code"]
    value = (code << 4) if polling["transport"] == "wired" else code
    if polling["single_adjust"]:
        value |= 0x80
    operations: list[dict] = [
        {
            "label": "polling",
            "cmd": 0x35,
            "sub": 0x01,
            "payload": bytes([value]),
            "expected": {
                "kind": "polling",
                "transport": polling["transport"],
                "code": code,
                "hz": polling["hz"],
            },
        }
    ]

    order = [
        index
        for index in range(1, dpi["stage_count"] + 1)
        if index != dpi["current_stage"]
    ]
    order.append(dpi["current_stage"])
    for index in order:
        stage = dpi["stages"][index - 1]
        combined = ((index & 0x0F) << 4) | (dpi["stage_count"] & 0x0F)
        payload = bytes(
            [
                combined,
                stage["raw"] & 0xFF,
                (stage["raw"] >> 8) & 0xFF,
                *bytes.fromhex(stage["color"][1:]),
            ]
        )
        operations.append(
            {
                "label": f"DPI stage {index}",
                "cmd": 0x3A,
                "sub": 0x00,
                "payload": payload,
                "expected": {
                    "kind": "dpi",
                    "stage": index,
                    "stage_count": dpi["stage_count"],
                    "dpi": stage["dpi"],
                    "color": stage["color"],
                },
            }
        )

    for button in buttons:
        operations.append(
            {
                "label": f"button {BUTTON_NAMES[button['index']]}",
                "cmd": 0x30,
                "sub": KEY_POS[BUTTON_NAMES[button["index"]]],
                "payload": bytes(button["raw"]),
                "expected": {
                    "kind": "button",
                    "index": button["index"],
                    "raw": tuple(button["raw"]),
                },
            }
        )

    summary = {
        "polling": {
            "hz": polling["hz"],
            "code": code,
            "transport": polling["transport"],
            "value": value,
            "is_single_adjust": polling["single_adjust"],
        },
        "dpi": {
            "stage_count": dpi["stage_count"],
            "current_stage": dpi["current_stage"],
            "max_dpi": dpi["max_dpi"],
            "stages": [
                {
                    "index": stage["index"],
                    "dpi": stage["dpi"],
                    "color": stage["color"],
                }
                for stage in dpi["stages"]
            ],
        },
        "buttons": [
            {
                "index": button["index"],
                "button": BUTTON_NAMES[button["index"]],
                "raw": _format_raw(tuple(button["raw"])),
            }
            for button in buttons
        ],
    }
    return operations, summary


def load_backup(path: str) -> dict:
    if not path:
        raise RestoreError("--backup requires a file path")
    target = os.path.abspath(os.path.expanduser(path))
    fd = -1
    try:
        info = os.lstat(target)
        if stat.S_ISLNK(info.st_mode):
            raise RestoreError(f"refusing to read symlink backup {target}")
        if not stat.S_ISREG(info.st_mode):
            raise RestoreError(f"backup {target} is not a regular file")
        if info.st_size > BACKUP_SIZE_LIMIT:
            raise RestoreError(f"backup {target} is too large")
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
        flags |= getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(target, flags)
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            fd = -1
            text = handle.read(BACKUP_SIZE_LIMIT + 1)
    except RestoreError:
        raise
    except (OSError, UnicodeError) as exc:
        raise RestoreError(f"could not read backup {target}: {exc}") from exc
    finally:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass

    if len(text) > BACKUP_SIZE_LIMIT:
        raise RestoreError(f"backup {target} is too large")
    try:
        document = json.loads(text)
    except (ValueError, UnicodeError) as exc:
        raise RestoreError(f"backup {target} is not valid JSON: {exc}") from exc
    if not isinstance(document, dict):
        raise RestoreError(f"backup {target} must contain a JSON object")
    return document


def emit(value: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(value))
    else:
        if value.get("ok"):
            if "battery" in value and "dpi" not in value:
                battery = value["battery"]
                name = sanitize_name(value.get("name")) or "EWEADN device"
                if battery["charging"]:
                    print(f"{name}: charging")
                else:
                    print(f"{name}: {battery['percent']}%")
            elif "dpi" in value:
                print_config(value)
            elif value.get("dry_run"):
                print("Dry run:", json.dumps(value.get("plan", {}), sort_keys=True))
                if value.get("source"):
                    print("Restore source:", sanitize_name(value["source"]))
                print("Re-run with --apply to write this to the mouse.")
            elif value.get("applied"):
                print("Applied:", json.dumps(value.get("plan", {}), sort_keys=True))
                if value.get("backup"):
                    print("Backup:", value["backup"])
                if value.get("source"):
                    print("Restore source:", sanitize_name(value["source"]))
            elif value.get("path") and value.get("config"):
                print("Backup:", value["path"])
            else:
                print(json.dumps(value, indent=2, sort_keys=True))
        else:
            print(
                f"eweadn-linux-control: {value.get('error', 'unknown error')}",
                file=sys.stderr,
            )


def print_config(config: dict) -> None:
    device = config["device"]
    battery = config["battery"]
    name = sanitize_name(device.get("name")) or "EWEADN device"
    source = sanitize_name(device.get("source")) or "unknown connection"
    print(f"{name} on {source}")
    if battery["charging"]:
        print("Battery: charging")
    else:
        print(f"Battery: {battery['percent']}%")

    if not config.get("settings_available", True):
        print("Settings: unavailable over Bluetooth (battery only)")
        return

    polling = config["polling"]
    dpi = config["dpi"]
    profile = config["profile"]
    print(f"Polling: {polling['hz']} Hz")
    print(
        "DPI: {} / {} stages, current {} DPI".format(
            len(dpi["stages"]),
            dpi["stage_count"],
            next(
                (
                    s["dpi"]
                    for s in dpi["stages"]
                    if s["index"] == dpi["current_stage"]
                ),
                "?",
            ),
        )
    )
    for stage in dpi["stages"][: dpi["stage_count"]]:
        marker = "*" if stage["index"] == dpi["current_stage"] else " "
        print(f"  {marker}{stage['index']}: {stage['dpi']} DPI {stage['color']}")
    print(f"Profile: {profile['current']} of {profile['max']}")
    for key in config["buttons"]:
        print(f"  {key['button']}: {key['action']}")


def command_config(args: argparse.Namespace, as_json: bool) -> int:
    debug = bool(getattr(args, "debug", False))
    if debug:
        as_json = True
    try:
        config, raw = read_config()
    except DeviceError as usb_error:
        # Only absence is safe to translate into a battery-only Bluetooth
        # view. A receiver that is present but broken must report its error.
        if not isinstance(usb_error, DeviceNotFound):
            raise
        try:
            config, raw = bluetooth_config()
        except DeviceError as bt_error:
            raise combine_errors(usb_error, bt_error)
    if debug:
        config["raw"] = raw
    emit(config, as_json)
    return 0


def command_backup(args: argparse.Namespace, as_json: bool) -> int:
    config, _ = read_config()
    path = save_backup(config, args.output)
    result = {"ok": True, "path": path, "config": config}
    emit(result, as_json)
    return 0


def command_set_polling(args: argparse.Namespace, as_json: bool) -> int:
    if args.hz not in HZ_TO_CODE:
        raise ValueError(
            f"unsupported polling rate {args.hz}; choose one of "
            f"{sorted(HZ_TO_CODE)}"
        )
    session = find_session()
    try:
        config, _ = read_config(session)
        payload, plan = plan_polling(
            config, args.hz, args.wired if args.wired else None
        )
        if not args.apply:
            emit(
                {"ok": True, "dry_run": True, "before": config, "plan": plan},
                as_json,
            )
            return 0
        path = save_backup(config, args.backup)
        after = write_and_verify(
            session,
            0x35,
            0x01,
            payload,
            [
                {
                    "kind": "polling",
                    "transport": plan["transport"],
                    "code": plan["code"],
                    "hz": plan["hz"],
                }
            ],
            backup=path,
        )
        emit(
            {
                "ok": True,
                "applied": True,
                "backup": path,
                "plan": plan,
                "after": after,
            },
            as_json,
        )
        return 0
    finally:
        session.close()


def command_set_dpi(args: argparse.Namespace, as_json: bool) -> int:
    if not 1 <= args.stage <= 8:
        raise ValueError("DPI stage must be between 1 and 8")
    if args.stage_count is not None and not 1 <= args.stage_count <= 8:
        raise ValueError("stage count must be between 1 and 8")
    if args.color is not None and not COLOR_RE.fullmatch(args.color):
        raise ValueError("color must be #RRGGBB")
    session = find_session()
    try:
        config, _ = read_config(session)
        payload, plan = plan_dpi(
            config, args.stage, args.dpi, args.stage_count, args.color
        )
        if not args.apply:
            emit(
                {"ok": True, "dry_run": True, "before": config, "plan": plan},
                as_json,
            )
            return 0
        path = save_backup(config, args.backup)
        after = write_and_verify(
            session,
            0x3A,
            0x00,
            payload,
            [
                {
                    "kind": "dpi",
                    "stage": plan["stage"],
                    "stage_count": plan["stage_count"],
                    "dpi": plan["dpi"],
                    "color": plan["color"],
                }
            ],
            backup=path,
        )
        emit(
            {
                "ok": True,
                "applied": True,
                "backup": path,
                "plan": plan,
                "after": after,
            },
            as_json,
        )
        return 0
    finally:
        session.close()


def command_set_button(args: argparse.Namespace, as_json: bool) -> int:
    if args.button not in BUTTON_NAMES:
        raise ValueError(f"button must be one of {', '.join(BUTTON_NAMES)}")
    index = BUTTON_NAMES.index(args.button)
    session = find_session()
    try:
        config, _ = read_config(session)
        pos, payload, plan = plan_button(index, args.action)
        if not args.apply:
            emit(
                {"ok": True, "dry_run": True, "before": config, "plan": plan},
                as_json,
            )
            return 0
        path = save_backup(config, args.backup)
        after = write_and_verify(
            session,
            0x30,
            pos,
            payload,
            [
                {
                    "kind": "button",
                    "index": index,
                    "raw": tuple(payload),
                }
            ],
            backup=path,
        )
        emit(
            {
                "ok": True,
                "applied": True,
                "backup": path,
                "plan": plan,
                "after": after,
            },
            as_json,
        )
        return 0
    finally:
        session.close()


def command_restore(args: argparse.Namespace, as_json: bool) -> int:
    source = os.path.abspath(os.path.expanduser(args.backup_file))
    document = load_backup(source)
    operations, plan = plan_restore(document)
    if not args.apply:
        emit(
            {
                "ok": True,
                "dry_run": True,
                "source": source,
                "backup": source,
                "plan": plan,
            },
            as_json,
        )
        return 0

    session = find_session()
    try:
        current, _ = read_config(session)
        path = save_backup(current)
        try:
            for operation in operations:
                apply_write(
                    session,
                    operation["cmd"],
                    operation["sub"],
                    operation["payload"],
                )
            try:
                after, _ = read_config(session)
            except DeviceError as exc:
                raise with_backup(exc, path)
            expectations = [
                operation["expected"] for operation in operations
            ]
            expectations.append(
                {
                    "kind": "dpi_current",
                    "stage": plan["dpi"]["current_stage"],
                }
            )
            verify_config(after, expectations, backup=path)
        except DeviceError as exc:
            raise with_backup(exc, path)
        emit(
            {
                "ok": True,
                "applied": True,
                "backup": path,
                "source": source,
                "plan": plan,
                "after": after,
            },
            as_json,
        )
        return 0
    finally:
        session.close()


def command_battery(as_json: bool) -> int:
    result, _ = read_battery()
    emit(result, as_json)
    return 0


class CliParser(argparse.ArgumentParser):
    """Usage errors use exit 1 and honour --json when it was requested."""

    json_hint = False

    def parse_args(
        self,
        args: list[str] | None = None,
        namespace: argparse.Namespace | None = None,
    ) -> argparse.Namespace:
        arguments = list(sys.argv[1:] if args is None else args)
        set_json_hint(self, "--json" in arguments)
        return super().parse_args(arguments, namespace)

    def error(self, message: str) -> None:
        if self.json_hint:
            print(json.dumps({"ok": False, "error": message}))
        else:
            self.print_usage(sys.stderr)
            print(f"{self.prog}: error: {message}", file=sys.stderr)
        raise SystemExit(1)


def set_json_hint(parser: argparse.ArgumentParser, enabled: bool) -> None:
    if isinstance(parser, CliParser):
        parser.json_hint = enabled
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for child in action.choices.values():
                set_json_hint(child, enabled)


def build_parser() -> argparse.ArgumentParser:
    parser = CliParser(
        description="Linux control helper for EWEADN mice (battery, polling, DPI, buttons)",
        epilog=(
            "Exit codes: 0 success, 1 validation/usage/IO error, "
            "2 device not found, 3 permission denied, 4 no reply/asleep, "
            "5 unexpected or unverified reply."
        ),
    )
    parser.json_hint = "--json" in sys.argv[1:]
    parser.add_argument(
        "--json",
        action="store_true",
        dest="json_global",
        help="print a JSON object (also available after a command)",
    )
    sub = parser.add_subparsers(dest="command")

    battery = sub.add_parser("battery", help="read battery (default)")
    battery.add_argument(
        "--json", action="store_true", dest="json_sub", help="print JSON"
    )

    config = sub.add_parser(
        "config", help="read polling, DPI, buttons and profile"
    )
    config.add_argument(
        "--json", action="store_true", dest="json_sub", help="print JSON"
    )
    config.add_argument(
        "--debug",
        action="store_true",
        help="include raw protocol frames; implies --json",
    )

    backup = sub.add_parser("backup", help="save a JSON configuration backup")
    backup.add_argument(
        "--json", action="store_true", dest="json_sub", help="print JSON"
    )
    backup.add_argument(
        "--output",
        metavar="PATH",
        help="write the backup to PATH instead of the state directory",
    )

    restore = sub.add_parser(
        "restore",
        help="restore polling, all DPI stages and five buttons from a backup",
    )
    restore.add_argument(
        "--backup",
        required=True,
        dest="backup_file",
        metavar="PATH",
        help="JSON backup created by the backup command",
    )
    restore.add_argument(
        "--apply",
        action="store_true",
        help="write the restored settings; default is a dry run",
    )
    restore.add_argument(
        "--json", action="store_true", dest="json_sub", help="print JSON"
    )

    polling = sub.add_parser("set-polling", help="set the polling rate")
    polling.add_argument("hz", type=int, help="polling rate in Hz")
    polling.add_argument(
        "--wired",
        action="store_true",
        help="use the wired (USB cable) polling nibble",
    )
    polling.add_argument(
        "--apply",
        action="store_true",
        help="write the setting; default is a dry run",
    )
    polling.add_argument(
        "--backup",
        metavar="PATH",
        help="write the pre-change backup to PATH",
    )
    polling.add_argument(
        "--json", action="store_true", dest="json_sub", help="print JSON"
    )

    dpi = sub.add_parser("set-dpi", help="set a DPI stage")
    dpi.add_argument("stage", type=int, help="DPI stage number (1-8)")
    dpi.add_argument("dpi", type=int, help="DPI value, a multiple of 50")
    dpi.add_argument(
        "--stage-count",
        type=int,
        help="number of active DPI stages (1-8)",
    )
    dpi.add_argument(
        "--color",
        metavar="#RRGGBB",
        help="stage LED color; uses the current color when omitted",
    )
    dpi.add_argument(
        "--apply",
        action="store_true",
        help="write the setting; default is a dry run",
    )
    dpi.add_argument(
        "--backup",
        metavar="PATH",
        help="write the pre-change backup to PATH",
    )
    dpi.add_argument(
        "--json", action="store_true", dest="json_sub", help="print JSON"
    )

    button = sub.add_parser("set-button", help="remap one mouse button")
    button.add_argument("button", choices=BUTTON_NAMES, help="button to remap")
    button.add_argument("action", choices=ACTION_NAMES, help="new action")
    button.add_argument(
        "--apply",
        action="store_true",
        help="write the setting; default is a dry run",
    )
    button.add_argument(
        "--backup",
        metavar="PATH",
        help="write the pre-change backup to PATH",
    )
    button.add_argument(
        "--json", action="store_true", dest="json_sub", help="print JSON"
    )

    return parser


def emit_error(error: DeviceError, as_json: bool) -> int:
    if as_json:
        value: dict[str, object] = {"ok": False, "error": str(error)}
        if error.backup:
            value["backup"] = error.backup
        print(json.dumps(value))
    else:
        print(f"eweadn-linux-control: {error}", file=sys.stderr)
    return error.exit_code


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    arguments = list(sys.argv[1:] if argv is None else argv)
    set_json_hint(parser, "--json" in arguments)
    args = parser.parse_args(arguments)
    as_json = bool(
        args.json_global
        or getattr(args, "json_sub", False)
        or getattr(args, "debug", False)
    )

    handlers = {
        "battery": lambda: command_battery(as_json),
        "config": lambda: command_config(args, as_json),
        "backup": lambda: command_backup(args, as_json),
        "restore": lambda: command_restore(args, as_json),
        "set-polling": lambda: command_set_polling(args, as_json),
        "set-dpi": lambda: command_set_dpi(args, as_json),
        "set-button": lambda: command_set_button(args, as_json),
    }
    try:
        handler = handlers.get(args.command or "battery")
        if handler is None:
            raise DeviceError(f"unknown command: {args.command}")
        return handler()
    except DeviceError as exc:
        return emit_error(exc, as_json)
    except OSError as exc:
        return emit_error(map_os_error(exc, "I/O error"), as_json)
    except ValueError as exc:
        return emit_error(DeviceError(str(exc)), as_json)
    except Exception as exc:  # keep --json output machine-readable
        return emit_error(DeviceError(f"unexpected error: {exc}"), as_json)


if __name__ == "__main__":
    raise SystemExit(main())
