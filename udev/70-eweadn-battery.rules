# EWEADN S9 8K receiver (372e:1026) and USB-cable mode (372e:1027).
# Grant the logged-in seat user access to the vendor HID interface only
# (interface 2, usage page FF00), which is where the battery and settings
# feature reports live.
SUBSYSTEM=="hidraw", ENV{ID_VENDOR_ID}=="372e", ENV{ID_MODEL_ID}=="1026", ENV{ID_USB_INTERFACE_NUM}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ENV{ID_VENDOR_ID}=="372e", ENV{ID_MODEL_ID}=="1027", ENV{ID_USB_INTERFACE_NUM}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
